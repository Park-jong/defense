{
  "name": "towerdefence-phaser-ts",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:git-hooks": "node --test sim/git-workflow.test.cjs",
    "test:bunker": "node --test sim/bunker.test.cjs",
    "test:campaign": "node --test sim/campaign.test.cjs",
    "test": "node --test sim/*.test.cjs",
    "predeploy": "node .claude/hooks/git-workflow.cjs deploy-check && npm run build",
    "deploy": "gh-pages -d dist",
    "postdeploy": "node .claude/hooks/git-workflow.cjs deployed"
  },
  "dependencies": {
    "phaser": "3.80.1"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
